generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  plan      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users          User[]
  projects       Project[]
  tasks          Task[]
  projectMembers ProjectMember[]
  refreshTokens  RefreshToken[]

  @@map("tenants")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String
  passwordHash String    @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  role         String    @default("member")
  tenantId     Int       @map("tenant_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  createdProjects Project[]       @relation("ProjectCreator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  projectMembers  ProjectMember[]
  refreshTokens   RefreshToken[]

  @@unique([email, tenantId])
  // Target for tenant-scoped composite foreign keys (see tasks / projects / project_members)
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  tenantId    Int       @map("tenant_id")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  creator User?           @relation("ProjectCreator", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: NoAction)
  tasks   Task[]
  members ProjectMember[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  tenantId  Int      @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)
  user    User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)

  @@unique([projectId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("todo")
  priority    String?
  projectId   Int       @map("project_id")
  tenantId    Int       @map("tenant_id")
  assignedTo  Int?      @map("assigned_to")
  dueDate     DateTime? @map("due_date")
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)
  assignee User?    @relation("TaskAssignee", fields: [tenantId, assignedTo], references: [tenantId, id], onDelete: NoAction)
  creator  User?    @relation("TaskCreator", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([projectId])
  @@index([assignedTo])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  // Trigram indexes so ILIKE '%term%' search doesn't seq-scan (needs pg_trgm, created in the migration)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_tasks_title_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_tasks_description_trgm")
  @@map("tasks")
}

// Server-side refresh-token store: lets us rotate on every refresh and
// invalidate on logout / user removal. Only the SHA-256 hash is stored.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  tenantId  Int       @map("tenant_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // Set only when the token was replaced by a refresh (not on logout / user removal);
  // lets parallel tabs that raced on the old token get a short grace period.
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}
