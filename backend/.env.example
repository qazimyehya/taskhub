NODE_ENV=development
PORT=3001

# Owner/superuser connection — used ONLY by Prisma migrations and scripts/setup-app-role.js
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/taskhub_db

# Restricted role the API runs as (RLS is enforced for it). Password must equal APP_DB_PASSWORD.
APP_DB_PASSWORD=CHANGE_ME_APP
APP_DATABASE_URL=postgresql://taskhub_app:CHANGE_ME_APP@localhost:5432/taskhub_db

# Generate each with: openssl rand -hex 48   (must be two different values)
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME_TOO

# Optional
# AUTH_RATE_LIMIT_MAX=10        # login/signup attempts per IP per 15 min (default: 10 in production, 100 otherwise)
# TRUST_PROXY=1                 # reverse-proxy hops in front of the API (nginx = 1)
# CORS_ORIGINS=http://localhost,http://localhost:5173
# COOKIE_SECURE=false           # defaults to true in production
