# Used by docker-compose. Copy to .env and fill in — never commit .env.
# Generate each secret with:  openssl rand -hex 32   (hex avoids characters that break URLs)

POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME_APP
JWT_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME_TOO   # must differ from JWT_SECRET

# Optional
# AUTH_RATE_LIMIT_MAX=10   # raise while load-testing
# COOKIE_SECURE=false      # only if you serve over plain http on a non-localhost host
